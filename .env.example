CLICKHOUSE_URL=https://192.168.1.7:8443
CLICKHOUSE_USER=sdar_telemetry_writer
CLICKHOUSE_PASSWORD_FILE=/run/secrets/clickhouse_password
CLICKHOUSE_SECURE=true
CLICKHOUSE_CONNECT_TIMEOUT_MS=5000
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000
CLICKHOUSE_QUERY_URL=https://192.168.1.7:8443
CLICKHOUSE_QUERY_USER=sdar_telemetry_reader
CLICKHOUSE_QUERY_PASSWORD_FILE=/run/secrets/clickhouse_query_password
CLICKHOUSE_QUERY_SECURE=true
CLICKHOUSE_QUERY_CONNECT_TIMEOUT_MS=5000
CLICKHOUSE_QUERY_REQUEST_TIMEOUT_MS=30000

WAL_DIR=/var/lib/sdar-telemetry/wal
WAL_HIGH_WATER_BYTES=536870912
GATEWAY_PORT=8080
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PUBLISH_HOST=127.0.0.1
QUERY_PORT=8081
QUERY_BIND_HOST=127.0.0.1
QUERY_PUBLISH_HOST=127.0.0.1
QUERY_MAX_RESULT_ROWS=10000
ADMIN_PORT=8082
ADMIN_PUBLISH_HOST=127.0.0.1
WORKER_INTERVAL_MS=1000
SDAR_EVIDENCE_SCHEMA_ROOT=/app/integrations/skill-driven-agent-runtime/v1.4.1/schemas/evidence/v1
EVIDENCE_INGEST_BEARER_TOKEN_FILE=/run/secrets/evidence_ingest_bearer_token
EVIDENCE_MAX_REQUEST_BYTES=67108864
QUERY_API_BEARER_TOKEN_FILE=/run/secrets/query_api_bearer_token

# Exactly one of EVIDENCE_INGEST_BEARER_TOKEN or EVIDENCE_INGEST_BEARER_TOKEN_FILE may be set.
# Keep inline tokens and all secret-file contents only in the untracked local .env/deploy/secrets.
# EVIDENCE_INGEST_BEARER_TOKEN=
# Exactly one of QUERY_API_BEARER_TOKEN or QUERY_API_BEARER_TOKEN_FILE may be set.
# QUERY_API_BEARER_TOKEN=

# Custom ClickHouse CA files currently fail closed instead of being silently ignored.
# Do not set CLICKHOUSE_CA_FILE or CLICKHOUSE_QUERY_CA_FILE until transport support is implemented.

# v1.3 compatibility only. The legacy relay reads telemetry_outbox and MUST NOT be pointed at
# an SDAR v1.4 Runtime database or its evidence_outbox. Leave unset unless explicitly running the
# legacy-v1.3 Compose profile against a v1.3-compatible receiver.
# SDAR_DATABASE_URL=
# INGESTION_URL=
# SDAR_SOURCE_ID=sdar-v1.3-legacy
# RELAY_INTERVAL_MS=1000
