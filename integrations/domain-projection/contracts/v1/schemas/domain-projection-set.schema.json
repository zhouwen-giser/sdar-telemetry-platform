{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdar.dev/schemas/domain-projection/v1/domain-projection-set.schema.json",
  "title": "DomainProjectionSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "projectionSetId",
    "projectionSetVersion",
    "projections",
    "projectionSetHash"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.domain-projection/v1" },
    "projectionSetId": { "$ref": "#/$defs/id" },
    "projectionSetVersion": { "$ref": "#/$defs/version" },
    "projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectionId",
          "projectionVersion",
          "mapperId",
          "mapperVersion",
          "definitionHash"
        ],
        "properties": {
          "projectionId": { "$ref": "#/$defs/id" },
          "projectionVersion": { "$ref": "#/$defs/version" },
          "mapperId": { "$ref": "#/$defs/id" },
          "mapperVersion": { "$ref": "#/$defs/semver" },
          "definitionHash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "projectionSetHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
