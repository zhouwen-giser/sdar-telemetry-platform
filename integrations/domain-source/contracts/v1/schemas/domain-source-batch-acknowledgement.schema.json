{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdar.dev/schemas/domain-source/v1/domain-source-batch-acknowledgement.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lastAcknowledgedSequence"
  ],
  "properties": {
    "lastAcknowledgedSequence": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "maxLength": 20
    }
  }
}
