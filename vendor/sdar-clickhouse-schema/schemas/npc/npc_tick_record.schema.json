{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/embodied-control/v1/npc_tick_record.schema.json",
  "title": "NPC Tick Record",
  "description": "NPC 每个 Tick 的实时闭环记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tickId",
    "episodeId",
    "sequence",
    "startedAt",
    "snapshotId",
    "activeBranch",
    "status"
  ],
  "properties": {
    "tickId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Tick 标识。"
    },
    "episodeId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "评价 Episode 唯一标识。"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Episode 内有序序号。"
    },
    "startedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "开始时间。"
    },
    "endedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp",
      "description": "结束时间。"
    },
    "snapshotId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Tick 使用的快照。"
    },
    "threatEvaluation": {
      "type": "object",
      "additionalProperties": true,
      "description": "威胁评估。"
    },
    "utilityEvaluation": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Utility 分数。"
    },
    "activeBranch": {
      "type": "string",
      "description": "活动行为树分支。"
    },
    "decisionId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "关联决策。"
    },
    "actionIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "default": [],
      "description": "节点产生的行动。"
    },
    "stateAfterId": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "节点后状态。"
    },
    "resetApplied": {
      "type": "boolean",
      "description": "是否应用重置。"
    },
    "overrunMs": {
      "type": "integer",
      "description": "Tick 超期时长。"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "overrun",
        "cancelled"
      ],
      "description": "当前状态。"
    },
    "notes": {
      "type": "string",
      "description": "说明。"
    }
  }
}
