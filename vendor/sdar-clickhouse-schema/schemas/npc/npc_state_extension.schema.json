{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/embodied-control/v1/npc_state_extension.schema.json",
  "title": "NPC Blackboard Extension",
  "description": "NPC Blackboard 在统一 StateSnapshot 中的领域扩展。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selfState",
    "perceptionState",
    "tacticalDecisionState",
    "missionState",
    "communicationState"
  ],
  "properties": {
    "selfState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "alt": {
              "type": "number"
            }
          }
        },
        "heading": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "health": {
          "type": "number",
          "minimum": 0
        },
        "ammo": {
          "type": "integer",
          "minimum": 0
        },
        "weaponRangeM": {
          "type": "number",
          "minimum": 0
        },
        "alive": {
          "type": "boolean"
        },
        "canFire": {
          "type": "boolean"
        },
        "team": {
          "type": "string"
        }
      }
    },
    "perceptionState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibleTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetId",
              "alive"
            ],
            "properties": {
              "targetId": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "distanceM": {
                "type": "number",
                "minimum": 0
              },
              "bearingDeg": {
                "type": "number"
              },
              "alive": {
                "type": "boolean"
              },
              "threatScore": {
                "type": "number"
              },
              "lastSeenAt": {
                "$ref": "common.schema.json#/$defs/Timestamp"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "default": []
        },
        "activeTargetId": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      }
    },
    "threatState": {
      "type": "object",
      "additionalProperties": true
    },
    "memoryState": {
      "type": "object",
      "additionalProperties": true
    },
    "tacticalDecisionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "ATTACK",
            "ESCAPE",
            "SCAN",
            "HOLD"
          ]
        },
        "utilityScores": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Utility 候选分数。"
        },
        "selectedTargetId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "reasonSummary": {
          "type": "string"
        }
      }
    },
    "missionState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "status": {
          "type": "string",
          "description": "当前状态。"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "计划或程序步骤。"
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "currentToolCallIndex": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "commandState": {
      "type": "object",
      "additionalProperties": true
    },
    "moveTaskState": {
      "type": "object",
      "additionalProperties": true
    },
    "hmiApprovalState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "expired"
          ],
          "description": "当前状态。"
        },
        "approvedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp",
          "description": "门槛判定有效期。"
        }
      }
    },
    "routeObstacleState": {
      "type": "object",
      "additionalProperties": true
    },
    "communicationState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upperCommandOnline": {
          "type": "boolean"
        },
        "lastHeartbeatAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "状态时效、置信度和冲突信息。"
        }
      }
    }
  }
}
