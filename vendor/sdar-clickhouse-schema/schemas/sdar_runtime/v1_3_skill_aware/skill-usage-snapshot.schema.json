{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/evidence/v1/skill-usage-snapshot.schema.json",
  "title": "Skill Usage Snapshot Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "usageSpecVersion",
    "usageSpecHash",
    "usageSpecSource",
    "visibility",
    "supportedModes",
    "defaultMode",
    "normativeHash",
    "adaptiveHash",
    "evidencePolicyHash",
    "snapshotArtifactRef",
    "lifecycleStatus",
    "capturedAt"
  ],
  "properties": {
    "skillId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "skillVersion": {
      "type": "integer",
      "minimum": 1
    },
    "usageSpecVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "usageSpecHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "usageSpecSource": {
      "$ref": "common-definitions.schema.json#/$defs/skillUsageSpecSource"
    },
    "visibility": {
      "enum": [
        "user_selectable",
        "composable",
        "internal_only"
      ]
    },
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "common-definitions.schema.json#/$defs/skillExecutionMode"
      }
    },
    "defaultMode": {
      "$ref": "common-definitions.schema.json#/$defs/skillExecutionMode"
    },
    "normativeHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "adaptiveHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "evidencePolicyHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "packageChecksum": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "packageSourceRef": {
      "type": "string",
      "maxLength": 4096
    },
    "snapshotArtifactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "lifecycleStatus": {
      "enum": [
        "draft",
        "candidate",
        "active",
        "deprecated",
        "retired",
        "disabled"
      ]
    },
    "capturedAt": {
      "$ref": "common-definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "usageSpecSource": {
            "const": "legacy_projection"
          }
        }
      },
      "then": {
        "properties": {
          "supportedModes": {
            "type": "array",
            "items": {
              "const": "guidance"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "defaultMode": {
            "const": "guidance"
          }
        }
      }
    }
  ]
}
