{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/embodied-control/v1/common.schema.json",
  "title": "SDAR Embodied-Control Common Definitions",
  "type": "object",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "AgentType": {
      "type": "string",
      "enum": [
        "commander",
        "npc"
      ]
    },
    "EpisodeType": {
      "type": "string",
      "enum": [
        "mission_execution",
        "direct_control",
        "tactical_response",
        "preemption_recovery",
        "anomaly_handling",
        "time_window",
        "simulation"
      ]
    },
    "EvidenceLevel": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "EpisodeStatus": {
      "type": "string",
      "enum": [
        "created",
        "active",
        "waiting",
        "blocked",
        "paused",
        "completed",
        "partial",
        "failed",
        "aborted",
        "cancelled"
      ]
    },
    "ExecutionStatus": {
      "type": "string",
      "enum": [
        "planned",
        "gated",
        "dispatched",
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "unknown"
      ]
    },
    "EntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "entityId"
      ],
      "properties": {
        "entityType": {
          "type": "string",
          "minLength": 1
        },
        "entityId": {
          "$ref": "#/$defs/Id"
        },
        "displayName": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ],
          "description": "版本。"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceId"
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": [
            "operator",
            "command_center",
            "peer_agent",
            "sensor",
            "mcp_server",
            "agent_runtime",
            "behavior_tree",
            "llm",
            "rule_engine",
            "system",
            "unknown"
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/Id"
        },
        "channel": {
          "type": "string"
        },
        "trustLevel": {
          "type": "string",
          "enum": [
            "trusted",
            "partially_trusted",
            "untrusted",
            "unknown"
          ]
        }
      }
    },
    "DataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "recordedAt",
        "status"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "recordedAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "记录时间。"
        },
        "validUntil": {
          "$ref": "#/$defs/Timestamp",
          "description": "失效时间。"
        },
        "freshnessMs": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "stale",
            "conflicted",
            "unknown"
          ],
          "description": "当前状态。"
        },
        "conflictRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "default": []
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceType",
        "evidenceId"
      ],
      "properties": {
        "evidenceType": {
          "type": "string"
        },
        "evidenceId": {
          "$ref": "#/$defs/Id"
        },
        "relation": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "caused_by",
            "produced_by",
            "validated_by",
            "derived_from",
            "supersedes",
            "related"
          ]
        },
        "schemaRef": {
          "type": "string"
        },
        "storageRef": {
          "type": "string",
          "description": "外部存储地址。"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{32,128}$",
          "description": "载荷哈希。"
        }
      }
    },
    "KeyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "description": "指标值。"
        },
        "unit": {
          "type": "string",
          "description": "单位。"
        },
        "sourceRef": {
          "$ref": "#/$defs/EvidenceRef",
          "description": "来源证据。"
        }
      }
    },
    "RiskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/RiskLevel",
          "description": "等级。"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "summary": {
          "type": "string",
          "description": "结构化摘要。"
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "default": [],
          "description": "证据引用。"
        }
      }
    },
    "ResourceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceType",
        "resourceId",
        "mode"
      ],
      "properties": {
        "resourceType": {
          "type": "string",
          "enum": [
            "chassis",
            "payload",
            "weapon",
            "sensor",
            "network",
            "compute",
            "other"
          ]
        },
        "resourceId": {
          "$ref": "#/$defs/Id"
        },
        "mode": {
          "type": "string",
          "enum": [
            "shared",
            "exclusive"
          ]
        },
        "acquiredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "releasedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Comparator": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "gt",
        "gte",
        "lt",
        "lte",
        "contains",
        "within",
        "exists",
        "not_exists",
        "custom"
      ]
    },
    "JsonPatchOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "remove",
            "replace",
            "move",
            "copy",
            "test"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "from": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {
          "description": "指标值。"
        }
      }
    },
    "MetricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "名称。"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean"
          ],
          "description": "指标值。"
        },
        "unit": {
          "type": "string",
          "description": "单位。"
        },
        "threshold": {
          "type": [
            "number",
            "integer",
            "string"
          ],
          "description": "阈值。"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "warning",
            "unknown"
          ],
          "description": "当前状态。"
        }
      }
    }
  }
}
