{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/telemetry/v1/ingestion-batch.schema.json",
  "title": "IngestionBatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batchId",
    "sourceId",
    "contractName",
    "contractVersion",
    "records"
  ],
  "properties": {
    "batchId": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "contractName": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string"
    },
    "firstSequence": {
      "type": "integer",
      "minimum": 0
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object"
      }
    }
  }
}
