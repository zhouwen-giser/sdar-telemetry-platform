COMPOSE_PROJECT_NAME=sdar-clickhouse

# This is the ClickHouse version used by the package validation matrix.
CLICKHOUSE_VERSION=25.3.10.19

CLICKHOUSE_USER=sdar
CLICKHOUSE_PASSWORD=replace_with_a_strong_password

# Bind to localhost by default. Change to 0.0.0.0 only with firewall/TLS controls.
CLICKHOUSE_HTTP_BIND=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_BIND=127.0.0.1
CLICKHOUSE_NATIVE_PORT=9000
