{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/evidence/v1/skill-mode-selection.schema.json",
  "title": "Skill Mode Selection Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modeSelectionId",
    "skillId",
    "skillVersion",
    "supportedModes",
    "status",
    "riskLevel",
    "contextCompleteness",
    "taskReadinessSummary",
    "reasonSummary",
    "evidenceRefs",
    "selectedAt"
  ],
  "properties": {
    "modeSelectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "skillId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "skillVersion": {
      "type": "integer",
      "minimum": 1
    },
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "common-definitions.schema.json#/$defs/skillExecutionMode"
      }
    },
    "selectedMode": {
      "$ref": "common-definitions.schema.json#/$defs/skillExecutionMode"
    },
    "status": {
      "enum": [
        "selected",
        "confirmation_required",
        "rejected"
      ]
    },
    "riskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "contextCompleteness": {
      "enum": [
        "complete",
        "partial",
        "insufficient"
      ]
    },
    "taskReadinessSummary": {
      "enum": [
        "available",
        "restricted",
        "disabled",
        "unknown",
        "not_checked"
      ]
    },
    "humanConfirmationId": {
      "type": "string",
      "maxLength": 256
    },
    "reasonSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "common-definitions.schema.json#/$defs/evidenceReference"
      }
    },
    "selectedAt": {
      "$ref": "common-definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "selected"
          }
        }
      },
      "then": {
        "required": [
          "selectedMode"
        ]
      }
    }
  ]
}
