{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/evidence/v1/skill-candidate-record.schema.json",
  "title": "Skill Candidate Record Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discoveryId",
    "candidateId",
    "skillId",
    "skillVersion",
    "retrievalSource",
    "visibility",
    "usageSpecSource",
    "eligible",
    "exclusionReasons",
    "candidateSnapshotHash",
    "discoveredAt"
  ],
  "properties": {
    "discoveryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "skillId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "skillVersion": {
      "type": "integer",
      "minimum": 1
    },
    "retrievalSource": {
      "enum": [
        "semantic",
        "skill_graph",
        "explicit",
        "fallback",
        "temporary"
      ]
    },
    "semanticScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "graphScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "qualityScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "combinedScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visibility": {
      "enum": [
        "user_selectable",
        "composable",
        "internal_only"
      ]
    },
    "usageSpecSource": {
      "$ref": "common-definitions.schema.json#/$defs/skillUsageSpecSource"
    },
    "eligible": {
      "type": "boolean"
    },
    "exclusionReasons": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "candidateSnapshotHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "discoveredAt": {
      "$ref": "common-definitions.schema.json#/$defs/timestamp"
    }
  }
}
