{
  "name": "sdar-telemetry-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "verify": "bash scripts/verify.sh",
    "sync:sdar-evidence-contract": "node --experimental-strip-types scripts/sync-sdar-evidence-contract.ts",
    "check:sdar-evidence-contract": "node --experimental-strip-types scripts/sync-sdar-evidence-contract.ts --check",
    "verify:domain-projection-contracts": "npm run build && node dist/scripts/verify-domain-projection-contracts.js",
    "check:benchmark-handoff": "npm run build && node integrations/sdar-benchmark-server/domain-projection/v1/verify.mjs",
    "check:benchmark-handoff:live": "npm run build && node --env-file-if-exists=.env integrations/sdar-benchmark-server/domain-projection/v1/verify.mjs --live",
    "check:benchmark-consumer": "npm run build && node dist/scripts/qualify-benchmark-consumer.js",
    "check:domain-projection-release": "npm run build && node dist/scripts/verify-domain-projection-release.js",
    "sync:domain-source-contracts": "npm run build && node dist/scripts/sync-domain-source-contracts.js",
    "check:domain-source-contracts": "npm run build && node dist/scripts/sync-domain-source-contracts.js --check",
    "sync:sdar-clickhouse-contract": "node --experimental-strip-types scripts/sync-sdar-clickhouse-contract.ts",
    "check:sdar-clickhouse-contract": "node --experimental-strip-types scripts/sync-sdar-clickhouse-contract.ts --check",
    "test:sdar-contract": "npm run build && node --test dist/tests/unit/evidence-v1-contract.test.js dist/tests/unit/sdar-contract-lock.test.js dist/tests/unit/normalizers.test.js dist/tests/integration/ingestion-gateway.test.js",
    "test:clickhouse-schema": "npm run build && node --test dist/tests/unit/clickhouse.test.js dist/tests/unit/projection-v1.test.js",
    "test:sdar-e2e": "npm run build && node --env-file-if-exists=.env dist/scripts/run-sdar-e2e.js",
    "test:domain-source-e2e": "npm run build && node --env-file-if-exists=.env dist/scripts/run-domain-source-e2e.js",
    "test:domain-projection-e2e": "npm run build && node --env-file-if-exists=.env dist/scripts/run-domain-projection-e2e.js",
    "test:domain-projection-control": "npm run build && node --env-file-if-exists=.env --test dist/tests/integration/domain-projection-control-postgres.test.js",
    "clickhouse:preflight": "npm run build && node --env-file-if-exists=.env dist/scripts/clickhouse-cli.js preflight",
    "clickhouse:domain-preflight": "npm run build && node --env-file-if-exists=.env dist/scripts/verify-domain-projection-clickhouse-preflight.js",
    "clickhouse:smpp-preflight": "npm run build && node --env-file-if-exists=.env dist/scripts/verify-smpp-providerops-clickhouse-preflight.js",
    "clickhouse:snapshot": "npm run build && node --env-file-if-exists=.env dist/scripts/clickhouse-schema-snapshot.js",
    "clickhouse:migrate": "npm run build && node --env-file-if-exists=.env dist/scripts/apply-evidence-v1-migration.js",
    "clickhouse:verify": "npm run build && node --env-file-if-exists=.env dist/scripts/clickhouse-cli.js verify",
    "clickhouse:smoke": "npm run build && node --env-file-if-exists=.env dist/scripts/clickhouse-cli.js smoke",
    "start:gateway": "node --env-file-if-exists=.env dist/apps/ingestion-gateway/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/telemetry-worker/src/main.js",
    "start:query": "node --env-file-if-exists=.env dist/apps/query-api/src/main.js",
    "start:admin": "node --env-file-if-exists=.env dist/apps/admin-api/src/main.js",
    "start:domain-worker": "node --env-file-if-exists=.env dist/apps/domain-projection-worker/src/main.js",
    "start:relay": "node --env-file-if-exists=.env dist/apps/sdar-outbox-relay/src/main.js"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
